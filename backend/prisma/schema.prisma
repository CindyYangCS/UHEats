// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum DiningCategory {
  DINING_HALL
  RESTAURANT
  CAFE
  MARKET
  VENDING_MACHINE
}

model DiningLocation {
  id           String         @id @default(uuid())
  name         String         @unique
  slug         String         @unique
  buildingName String
  hours        DiningHours[]
  foodItems    FoodItem[]
  category     DiningCategory
  updatedAt    DateTime       @updatedAt
}

model DiningHours {
  id        String   @id @default(uuid())
  dayOfWeek Int
  openTime  DateTime @db.Time
  closeTime DateTime @db.Time

  diningLocationId String
  diningLocation   DiningLocation @relation(fields: [diningLocationId], references: [id], onDelete: Cascade)
}

model FoodItem {
  id          String   @id @default(uuid())
  name        String
  servingUnit String
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  updatedAt   DateTime @updatedAt

  diningLocationId String
  diningLocation   DiningLocation @relation(fields: [diningLocationId], references: [id], onDelete: Cascade)
}
